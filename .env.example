# Copy to .env locally (never commit .env). On Railway, set these as service variables.

# Supabase > Project Settings > Database > Connection string (URI). Use the pooler URI
# on Railway (port 6543) and the direct URI (port 5432) for one-off migrations.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# Shared secret Instantly sends in the `x-rs-webhook-token` (or `rs-webhook`) header.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
INSTANTLY_WEBHOOK_TOKEN=

# Only needed by analyze_replies.py (reply classification). Leave blank to run rules-only.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
