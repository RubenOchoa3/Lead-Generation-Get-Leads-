# ── Required (Railway → web service → Variables)
DATABASE_URL=${{Postgres.DATABASE_URL}}   # Railway reference variable; private network, no TLS needed
APP_USER=rs                                # dashboard login (HTTP Basic)
APP_PASSWORD=                              # long random password — app refuses to serve without it in production
INGEST_SECRET=                             # long random string; lets Claude push Getlead/InboxKit data and research
CRON_SECRET=                               # long random string; for the scheduled daily engine (disabled by default)

# ── Optional: Getlead server-side search (Find Leads → Get Leads / Preview count)
GETLEAD_API_KEY=
GETLEAD_API_BASE=                          # e.g. the GetLeads REST base URL from their API docs
# GETLEAD_COUNT_PATH=/api/v1/contacts/count   # override if GetLeads' documented paths differ
# GETLEAD_SEARCH_PATH=/api/v1/contacts/search

# ── Optional: server-side Claude research (otherwise research is pushed from a Claude session)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Optional: direct InboxKit sync (otherwise snapshots are pushed from Claude's InboxKit MCP)
INBOXKIT_API_KEY=

APP_TIMEZONE=America/Los_Angeles
